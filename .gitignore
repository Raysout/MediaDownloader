# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE & editors
.idea/
.vscode/
*.swp
*.swo

# PyInstaller / Build artifacts
build/
dist/
*.spec

# Archives & Temporary files
*.rar
*.zip
*.tar.gz
ffmpeg_temp.zip
*.tmp
*.log

# Binaries / FFmpeg (large files excluded from git)
media_downloader/bin/*.exe
media_downloader/bin/ffmpeg
media_downloader/bin/ffprobe
!media_downloader/bin/.gitkeep

# User data & credentials
download_history.json
*cookies*.txt
*.cookie

# Downloaded media files
*.mp4
*.mp3
*.mkv
*.webm
*.flac
*.m4a
*.opus
*.wav

# Operating System
Thumbs.db
Desktop.ini
.DS_Store
